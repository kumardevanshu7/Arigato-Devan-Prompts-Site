# Pretty prompt URLs (optional — prompt.php?slug= also works)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^prompts/([a-zA-Z0-9_-]+)/?$ prompt.php?slug=$1 [L,QSA]
    # Not Mine clean URLs only — /not-mine/{slug}
    RewriteRule ^not-mine/([a-z0-9][a-z0-9-]*)/?$ not-mine/prompt.php?slug=$1 [L,QSA,NC]
</IfModule>

ErrorDocument 404 /404.php
ErrorDocument 500 /500.php
